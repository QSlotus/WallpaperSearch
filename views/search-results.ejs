<header class="page-header">
  <div class="page-header-main">
    <a class="icon-button" href="/" aria-label="Back to home" title="Back to home">
      <i data-lucide="arrow-left" aria-hidden="true"></i>
    </a>
    <div>
      <h1>Search</h1>
      <p><%= searchtext ? 'Results for "' + searchtext + '"' : 'Browse Workshop items' %></p>
    </div>
  </div>
</header>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="notice notice-danger" role="alert">
    <i data-lucide="circle-alert" aria-hidden="true"></i>
    <div>
      <%= error %>
      <% if (typeof errorAction !== 'undefined' && errorAction === 'invite') { %>
        <a href="/invite-code">Enter an invite code</a>.
      <% } %>
    </div>
  </div>
<% } %>

<section class="search-section" aria-label="Refine wallpaper search">
  <%- include('search-form') %>
</section>

<div class="results-summary">
  <span><strong><%= items.length %></strong> items on this page</span>
  <span>Page <%= page %> of <%= maxPage %></span>
</div>

<% if (items.length > 0) { %>
  <section class="results-feed" aria-label="Wallpaper results">
    <% items.forEach(item => { %>
      <article class="wallpaper-post">
        <a class="wallpaper-post-link" href="/item/<%= item.sharedfileId %>">
          <div class="wallpaper-preview">
            <img src="<%= item.previewImage %>" alt="<%= item.title %>" loading="lazy">
          </div>
          <div class="wallpaper-post-content">
            <h2 class="wallpaper-post-title"><%= item.title %></h2>
            <p class="wallpaper-post-author">by <%= item.authorName %></p>
            <span class="wallpaper-post-action">
              View details
              <i data-lucide="arrow-up-right" aria-hidden="true"></i>
            </span>
          </div>
        </a>
      </article>
    <% }) %>
  </section>
<% } else if (typeof error === 'undefined') { %>
  <section class="empty-state">
    <div class="empty-state-inner">
      <div class="empty-state-icon"><i data-lucide="search-x" aria-hidden="true"></i></div>
      <h2>No wallpapers found</h2>
      <p>Try another search term or adjust the audience, type, and sort filters.</p>
    </div>
  </section>
<% } %>

<% if (maxPage > 1) { %>
  <nav class="pagination-wrap" aria-label="Search result pages">
    <ul class="pagination">
      <% if (page > 1) { %>
        <% if (page > 2) { %>
          <li>
            <a class="page-link" href="/search?searchtext=<%= encodeURIComponent(searchtext) %>&requiredtags=<%= requiredtags %>&requiredtype=<%= requiredtype %>&section=<%= section %>&p=1&browsesort=<%= browsesort %>">First</a>
          </li>
        <% } %>
        <li>
          <a class="page-link" href="/search?searchtext=<%= encodeURIComponent(searchtext) %>&requiredtags=<%= requiredtags %>&requiredtype=<%= requiredtype %>&section=<%= section %>&p=<%= parseInt(page) - 1 %>&browsesort=<%= browsesort %>">
            <i data-lucide="chevron-left" aria-hidden="true"></i>
            Previous
          </a>
        </li>
      <% } %>
      <li><span class="page-link page-current">Page <%= page %> of <%= maxPage %></span></li>
      <% if (page < maxPage) { %>
        <li>
          <a class="page-link" href="/search?searchtext=<%= encodeURIComponent(searchtext) %>&requiredtags=<%= requiredtags %>&requiredtype=<%= requiredtype %>&section=<%= section %>&p=<%= parseInt(page) + 1 %>&browsesort=<%= browsesort %>">
            Next
            <i data-lucide="chevron-right" aria-hidden="true"></i>
          </a>
        </li>
        <% if (page < maxPage - 1) { %>
          <li>
            <a class="page-link" href="/search?searchtext=<%= encodeURIComponent(searchtext) %>&requiredtags=<%= requiredtags %>&requiredtype=<%= requiredtype %>&section=<%= section %>&p=<%= maxPage %>&browsesort=<%= browsesort %>">Last</a>
          </li>
        <% } %>
      <% } %>
    </ul>
  </nav>
<% } %>

<%- include('search-behavior') %>
