<header class="page-header">
  <div class="page-header-main">
    <a class="icon-button" href="/" aria-label="Back to home" title="Back to home">
      <i data-lucide="arrow-left" aria-hidden="true"></i>
    </a>
    <div>
      <h1>Invite Code</h1>
      <p>Mature content access</p>
    </div>
  </div>
</header>

<% if (typeof error !== 'undefined') { %>
  <div class="notice notice-danger" role="alert">
    <i data-lucide="circle-alert" aria-hidden="true"></i>
    <span><%= error %></span>
  </div>
<% } %>

<% const nextPath = typeof next !== 'undefined' && next ? next : '/'; %>
<% if (typeof unlocked !== 'undefined' && unlocked) { %>
  <div class="notice notice-success" role="status">
    <i data-lucide="badge-check" aria-hidden="true"></i>
    <span>Mature content search is unlocked on this browser.</span>
  </div>
  <section class="empty-state">
    <div class="empty-state-inner">
      <div class="empty-state-icon"><i data-lucide="shield-check" aria-hidden="true"></i></div>
      <h2>Access unlocked</h2>
      <p>You can now select Mature in the audience filter.</p>
      <a class="button button-primary" href="<%= nextPath %>">
        <i data-lucide="arrow-right" aria-hidden="true"></i>
        Continue
      </a>
    </div>
  </section>
<% } else { %>
  <section class="auth-content">
    <p>Enter your invite code to unlock the Mature option in Wallpaper Search.</p>
    <form class="invite-form" action="/submit-invite-code" method="post">
      <input type="hidden" name="next" value="<%= nextPath %>">
      <label class="text-field" for="inviteCode">
        <span>Invite code</span>
        <input type="text" id="inviteCode" name="inviteCode" required autocomplete="off" autofocus>
      </label>
      <div class="auth-actions">
        <button type="submit" class="button button-primary">
          <i data-lucide="unlock" aria-hidden="true"></i>
          Unlock access
        </button>
      </div>
    </form>
  </section>
<% } %>
