<% const currentSearchText = typeof searchtext !== 'undefined' ? searchtext : ''; %>
<% const currentRequiredTags = typeof requiredtags !== 'undefined' ? requiredtags : 'Everyone'; %>
<% const currentRequiredType = typeof requiredtype !== 'undefined' ? requiredtype : ''; %>
<% const currentBrowseSort = typeof browsesort !== 'undefined' ? browsesort : 'textsearch'; %>
<% const currentPage = typeof page !== 'undefined' ? page : 1; %>
<%
  const defaultSortChoices = [
    ['textsearch', 'Relevance'],
    ['totaluniquesubscribers', 'Most subscribed'],
    ['mostrecent', 'Most recent'],
    ['trend&days=1', 'Trending today'],
    ['trend&days=7', 'Trending 7 days'],
    ['trend&days=30', 'Trending 30 days'],
    ['trend&days=365', 'Trending year'],
    ['trend&days=-1', 'Trending all time'],
  ];
  const sortChoices = typeof sortOptions !== 'undefined' ? sortOptions : defaultSortChoices;
  const formTarget = typeof formAction !== 'undefined' ? formAction : '/search';
%>

<form action="<%= formTarget %>" method="get" class="search-form-main">
  <div class="search-query-row">
    <label class="search-query-field">
      <i data-lucide="search" aria-hidden="true"></i>
      <span class="sr-only">Search wallpapers</span>
      <input type="search" name="searchtext" value="<%= currentSearchText %>" placeholder="Search wallpapers" autocomplete="off">
    </label>
    <button type="submit" class="button button-primary search-submit">
      <i data-lucide="search" aria-hidden="true"></i>
      <span>Search</span>
    </button>
  </div>

  <div class="filter-grid">
    <label class="filter-control">
      <span>Audience</span>
      <select name="requiredtags">
        <option value="Everyone" <%= currentRequiredTags === 'Everyone' ? 'selected' : '' %>>Everyone</option>
        <option value="Questionable" <%= currentRequiredTags === 'Questionable' ? 'selected' : '' %>>Questionable</option>
        <option value="Mature" <%= currentRequiredTags === 'Mature' ? 'selected' : '' %>>Mature</option>
      </select>
    </label>
    <label class="filter-control">
      <span>Type</span>
      <select name="requiredtype">
        <option value="" <%= currentRequiredType === '' ? 'selected' : '' %>>All types</option>
        <option value="Scene" <%= currentRequiredType === 'Scene' ? 'selected' : '' %>>Scene</option>
        <option value="Video" <%= currentRequiredType === 'Video' ? 'selected' : '' %>>Video</option>
        <option value="Web" <%= currentRequiredType === 'Web' ? 'selected' : '' %>>Web</option>
      </select>
    </label>
    <label class="filter-control filter-control-wide">
      <span>Sort by</span>
      <select name="browsesort">
        <% sortChoices.forEach(function (choice) { %>
          <option value="<%= choice[0] %>" <%= currentBrowseSort === choice[0] ? 'selected' : '' %>><%= choice[1] %></option>
        <% }); %>
      </select>
    </label>
  </div>
  <input type="hidden" name="p" value="<%= currentPage %>">
</form>
