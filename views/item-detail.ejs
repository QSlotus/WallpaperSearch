<header class="page-header">
  <div class="page-header-main">
    <button class="icon-button" type="button" onclick="history.back()" aria-label="Go back" title="Go back">
      <i data-lucide="arrow-left" aria-hidden="true"></i>
    </button>
    <div>
      <h1><%= item.title %></h1>
      <p>Workshop item</p>
    </div>
  </div>
</header>

<% const galleryShots = Array.isArray(item.gallery) ? item.gallery : []; %>
<% const thumbQuery = '?imw=240&imh=135&ima=fit&impolicy=Letterbox&imcolor=%23000000&letterbox=false'; %>
<section class="detail-hero" aria-label="Wallpaper preview">
  <img id="detail-hero-image" src="<%= item.previewImage %>" alt="<%= item.title %>">

  <% if (galleryShots.length > 1) { %>
    <div class="detail-gallery" role="group" aria-label="Preview images">
      <% galleryShots.forEach(function (shot, index) { %>
        <button class="detail-gallery-item<%= index === 0 ? ' is-active' : '' %>" type="button"
                data-gallery-src="<%= shot.url %>"
                aria-pressed="<%= index === 0 ? 'true' : 'false' %>"
                aria-label="Show preview image <%= index + 1 %> of <%= galleryShots.length %>">
          <img src="<%= shot.url %><%= thumbQuery %>" alt="" loading="lazy">
        </button>
      <% }); %>
    </div>
  <% } %>

  <% if (Array.isArray(item.previewVideos) && item.previewVideos.length > 0) { %>
    <a class="detail-video-link" href="https://www.youtube.com/watch?v=<%= item.previewVideos[0].youtubeId %>"
       target="_blank" rel="noopener noreferrer">
      <i data-lucide="play" aria-hidden="true"></i>
      <span>Watch preview video</span>
    </a>
  <% } %>
</section>

<section class="detail-section" aria-labelledby="creator-heading">
  <h2 class="detail-section-title" id="creator-heading">Creator</h2>
  <div class="creator-row">
    <div class="creator-avatar-wrap">
      <% if (item.creatorAvatarUrl) { %>
        <img class="creator-avatar-image" src="<%= item.creatorAvatarUrl %>" alt="Creator Avatar">
      <% } else { %>
        <div class="creator-avatar-placeholder"><i data-lucide="user" aria-hidden="true"></i></div>
      <% } %>
    </div>
    <div class="creator-copy">
      <p class="creator-name"><%= item.creatorName || 'Unknown Creator' %></p>
      <p class="creator-label">Workshop uploader</p>
    </div>
    <div class="creator-actions">
      <% if (item.creatorId) { %>
        <a class="button profile-link" href="/author/<%= item.creatorId %>">
          <i data-lucide="layout-grid" aria-hidden="true"></i>
          <span>All items</span>
        </a>
      <% } %>
      <% if (item.creatorProfileUrl) { %>
        <a class="button profile-link" href="<%= item.creatorProfileUrl %>" target="_blank" rel="noopener noreferrer">
          <i data-lucide="external-link" aria-hidden="true"></i>
          <span>Profile</span>
        </a>
      <% } %>
    </div>
  </div>
</section>

<section class="detail-section" aria-labelledby="info-heading">
  <h2 class="detail-section-title" id="info-heading">Wallpaper info</h2>
  <div class="detail-stats">
    <div class="detail-stat">
      <span>Type</span>
      <% if (item.type === 'Application' || item.type === 'Web') { %>
        <strong class="status-danger"><%= item.type %></strong>
      <% } else { %>
        <strong class="status-safe"><%= item.type %></strong>
      <% } %>
    </div>
    <div class="detail-stat">
      <span>Age rating</span>
      <% if (item.ageRating === 'Everyone') { %>
        <strong class="status-safe"><%= item.ageRating %></strong>
      <% } else if (item.ageRating === 'Questionable') { %>
        <strong class="status-warning"><%= item.ageRating %></strong>
      <% } else if (item.ageRating === 'Mature') { %>
        <strong class="status-danger"><%= item.ageRating %></strong>
      <% } else { %>
        <strong><%= item.ageRating %></strong>
      <% } %>
    </div>
    <div class="detail-stat"><span>File size</span><strong><%= item.fileSize %></strong></div>
    <div class="detail-stat"><span>Subscribers</span><strong><%= item.currentSubscribers || 'N/A' %></strong></div>
    <div class="detail-stat"><span>Favorites</span><strong><%= item.currentFavorites || 'N/A' %></strong></div>
    <div class="detail-stat"><span>Created</span><strong><%= item.timeCreated %></strong></div>
    <div class="detail-stat"><span>Updated</span><strong><%= item.timeUpdated %></strong></div>
    <div class="detail-stat"><span>Workshop ID</span><strong><%= item.id %></strong></div>
  </div>
  <div class="workshop-source">
    <i data-lucide="link" aria-hidden="true"></i>
    <a class="workshop-link" href="https://steamcommunity.com/sharedfiles/filedetails/?id=<%= item.id %>" target="_blank" rel="noopener noreferrer">
      Steam Workshop :: <%= item.title %>
    </a>
  </div>
</section>

<section class="detail-section" aria-labelledby="description-heading">
  <h2 class="detail-section-title" id="description-heading">Description</h2>
  <div class="description-blockquote" id="description-blockquote">
    <%- item.description %>
  </div>
</section>

<section class="detail-section" aria-labelledby="command-heading">
  <h2 class="detail-section-title" id="command-heading">SteamCMD command</h2>
  <div class="command-box">
    <code class="command-code" id="steamcmd-command">workshop_download_item 431960 <%= item.id %></code>
    <button id="copy-button" class="icon-button copy-button btn-outline-secondary" type="button" aria-label="Copy SteamCMD command" title="Copy command">
      <i data-lucide="copy" aria-hidden="true"></i>
    </button>
  </div>
</section>

<div id="custom-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="external-link-title">
  <div class="modal-content">
    <h2 id="external-link-title">Open external link?</h2>
    <p>This URL comes from the Steam Workshop description and is not managed by this site. Continue only if you trust the destination.</p>
    <div class="modal-actions">
      <button id="modal-cancel-btn" class="button button-secondary btn-secondary" type="button">Cancel</button>
      <a id="modal-confirm-link" class="button button-primary btn-primary" href="#" target="_blank" rel="noopener noreferrer">Continue</a>
    </div>
  </div>
</div>

<script>
  var heroImage = document.getElementById('detail-hero-image');
  var galleryButtons = document.querySelectorAll('[data-gallery-src]');

  Array.prototype.forEach.call(galleryButtons, function(button) {
    button.addEventListener('click', function() {
      var src = button.getAttribute('data-gallery-src');
      if (!src || !heroImage) return;
      heroImage.src = src;
      Array.prototype.forEach.call(galleryButtons, function(other) {
        var isActive = other === button;
        other.classList.toggle('is-active', isActive);
        other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    });
  });

  document.getElementById('copy-button').addEventListener('click', function() {
    const commandText = document.getElementById('steamcmd-command').innerText;
    const copyButton = document.getElementById('copy-button');
    const originalMarkup = copyButton.innerHTML;

    navigator.clipboard.writeText(commandText).then(function() {
      copyButton.innerHTML = '<i data-lucide="check" aria-hidden="true"></i><span class="sr-only">Copied!</span>';
      copyButton.setAttribute('title', 'Copied!');
      copyButton.setAttribute('aria-label', 'Command copied');
      copyButton.classList.remove('btn-outline-secondary');
      copyButton.classList.add('btn-success');
      if (window.lucide) window.lucide.createIcons({ attrs: { 'stroke-width': 2 } });

      setTimeout(function() {
        copyButton.innerHTML = originalMarkup;
        copyButton.setAttribute('title', 'Copy command');
        copyButton.setAttribute('aria-label', 'Copy SteamCMD command');
        copyButton.classList.remove('btn-success');
        copyButton.classList.add('btn-outline-secondary');
        if (window.lucide) window.lucide.createIcons({ attrs: { 'stroke-width': 2 } });
      }, 2000);
    }).catch(function(err) {
      console.error('Failed to copy text: ', err);
    });
  });

  const modal = document.getElementById('custom-modal');
  const confirmLink = document.getElementById('modal-confirm-link');
  const cancelBtn = document.getElementById('modal-cancel-btn');

  document.getElementById('description-blockquote').addEventListener('click', function(event) {
    const anchor = event.target.closest('a');
    if (anchor) {
      event.preventDefault();
      confirmLink.href = anchor.href;
      modal.style.display = 'flex';
    }
  });

  confirmLink.addEventListener('click', function() {
    modal.style.display = 'none';
  });

  cancelBtn.addEventListener('click', function() {
    modal.style.display = 'none';
  });

  window.addEventListener('click', function(event) {
    if (event.target === modal) {
      modal.style.display = 'none';
    }
  });
</script>
