COOKIE_ENCRYPT_KEY=
COOKIE_REPO_OWNER=QSlotus
COOKIE_REPO_NAME=auto-we
COOKIE_FILE_PATH=cookie.enc.json
INVITE_CODE=
PORT=3000

# 上游请求超时（毫秒），默认 15000
UPSTREAM_TIMEOUT_MS=15000
# 搜索结果进程内缓存时长（毫秒），默认 300000（5 分钟）
SEARCH_CACHE_TTL_MS=300000
# 详情页进程内缓存时长（毫秒），默认 600000（10 分钟）
ITEM_CACHE_TTL_MS=600000
# 页面时间展示的时区偏移（小时），默认 8 = 北京时间
DISPLAY_TZ_OFFSET_HOURS=8
# 仅当本机被 hosts 劫持（如 Watt Toolkit）导致证书校验失败时临时设为 1。
# 生产环境绝不要开启，否则 Steam/GitHub 请求可被中间人劫持。
ALLOW_INSECURE_TLS=
